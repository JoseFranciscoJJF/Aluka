{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=aluka.db"
  },
  "Logging": {
    "MinimumLevel": "Information"
  },
  "Scheduler": {
    "IntervalSeconds": 30
  },
  "History": {
    "RetentionDays": 7,
    "CleanupIntervalHours": 24
  },
  "Notifications": {
    "Enabled": true,
    "DefaultType": "Information",
    "DefaultDuration": "Short",
    "DefaultDelaySeconds": 0,
    "CooldownMinutes": 60
  }
}